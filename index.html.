    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #FAF6F5; /* Tono lino cálido de fondo */
            background-image: radial-gradient(#eadaeb 0.8px, transparent 0.8px), radial-gradient(#eadaeb 0.8px, #faf6f5 0.8px);
