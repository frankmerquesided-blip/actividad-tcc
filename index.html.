    <script>
        // ==========================================
        // SINTETIZADOR DE MÚSICA CHILL DE AMBIENTE (Web Audio API)
        // ==========================================
        let isSoundEnabled = true;
        let isAmbientPlaying = false;
        
        // Contexto de Audio compartido
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        // Nodos del sintetizador de ambiente
        let ambientOscillators = [];
        let ambientGainNode = null;
        let noiseFilter = null;
        let noiseSource = null;

        function playSynthSound(type) {
            if (!isSoundEnabled) return;
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'correct') {
                // Tono de campana de viento suave
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
                osc.frequency.exponentialRampToValueAtTime(880.00, audioCtx.currentTime + 0.2); // A5
                gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.4);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.4);
            } else if (type === 'wrong') {
                // Tono suave sordo (sin ser molesto)
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(220.00, audioCtx.currentTime); // A3
                osc.frequency.linearRampToValueAtTime(146.83, audioCtx.currentTime + 0.3); // D3
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.35);
            } else if (type === 'match') {
                // Sonido corto brillante
                osc.type = 'sine';
                osc.frequency.setValueAtTime(783.99, audioCtx.currentTime); // G5
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.15);
            }
        }

        // CONTROLADOR DE MÚSICA DE FONDO (DISEÑO CHILL CON CUENCOS Y BRISA)
        function startAmbientMusic() {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            // Ganancia principal para el ambiente (volumen bajo y relajante)
            ambientGainNode = audioCtx.createGain();
            ambientGainNode.gain.setValueAtTime(0.07, audioCtx.currentTime);
            ambientGainNode.connect(audioCtx.destination);

            // 1. Drones Armónicos de Cuencos de Cuarzo (Frecuencias puras pentatónicas de La Mayor)
            // La2 (110Hz), Do#3 (138.6Hz), Mi3 (164.8Hz), La3 (220Hz)
            const chords = [110.00, 138.61, 164.81, 220.00];
            ambientOscillators = chords.map((freq, index) => {
                const osc = audioCtx.createOscillator();
                const nodeGain = audioCtx.createGain();
                
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                
                // LFO (Modulador de volumen lento para recrear el "vaivén" de los cuencos)
                nodeGain.gain.setValueAtTime(0.02, audioCtx.currentTime);
                
                osc.connect(nodeGain);
                nodeGain.connect(ambientGainNode);
                osc.start();

                // Animación de volumen (respiración)
                const breatheVolume = () => {
                    if (!isAmbientPlaying) return;
                    const duration = 4 + index * 1.5;
                    nodeGain.gain.exponentialRampToValueAtTime(0.08, audioCtx.currentTime + duration/2);
                    nodeGain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                    setTimeout(breatheVolume, duration * 1000);
                };
                breatheVolume();

                return osc;
            });

            // 2. Ruido Rosa de Brisa Marina/Viento en el Jardín
            const bufferSize = audioCtx.sampleRate * 2; // 2 segundos de buffer de ruido
            const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const output = noiseBuffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                output[i] = Math.random() * 2 - 1;
            }

            noiseSource = audioCtx.createBufferSource();
            noiseSource.buffer = noiseBuffer;
            noiseSource.loop = true;

            // Filtro de viento suave
            noiseFilter = audioCtx.createBiquadFilter();
            noiseFilter.type = 'lowpass';
            noiseFilter.frequency.setValueAtTime(250, audioCtx.currentTime);

            noiseSource.connect(noiseFilter);
            noiseFilter.connect(ambientGainNode);
            noiseSource.start();

            // Animación de barrido del filtro de viento (crea el efecto de olas)
            const animateWind = () => {
                if (!isAmbientPlaying) return;
                const waveTime = 6 + Math.random() * 3;
                noiseFilter.frequency.exponentialRampToValueAtTime(450, audioCtx.currentTime + waveTime/2);
                noiseFilter.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + waveTime);
                setTimeout(animateWind, waveTime * 1000);
            };
            animateWind();
        }

        function stopAmbientMusic() {
            if (ambientGainNode) {
                ambientGainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1);
                setTimeout(() => {
                    ambientOscillators.forEach(osc => { try { osc.stop(); } catch(e){} });
                    ambientOscillators = [];
                    try { noiseSource.stop(); } catch(e){}
                    noiseSource = null;
                    ambientGainNode = null;
                }, 1000);
            }
        }

