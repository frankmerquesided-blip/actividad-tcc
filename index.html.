                        btn.querySelector('.indicator-icon').innerHTML = '✅';
                    } else if (answeredQuestions[currentQuestionIdx] === idx) {
                        btn.className = `w-full text-left p-4 rounded-2xl border text-xs font-semibold bg-rose-50/90 border-rose-300 text-rose-950 flex justify-between items-center shadow-sm`;
                        btn.querySelector('.indicator-icon').innerHTML = '❌';
                    } else {
                        btn.className = `w-full text-left p-4 rounded-2xl border text-xs font-semibold bg-stone-50/50 border-stone-200 text-stone-400 flex justify-between items-center`;
                        btn.querySelector('span').classList.add('opacity-40');
                    }
                }

                // Generar Tooltip flotante con la definición
                const tooltipDef = definitions[opt.text.trim()] || "Pensamiento irracional que distorsiona la realidad de forma automática.";
                const tooltip = document.createElement('div');
                tooltip.className = "absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2.5 hidden group-hover:block w-72 p-3 bg-stone-900/95 backdrop-blur text-stone-100 text-[11px] font-normal leading-relaxed rounded-xl shadow-xl z-50 pointer-events-none transition-all duration-200 border border-stone-800 text-center";
                tooltip.innerHTML = `
                    <span class="font-bold text-mauve-300 block mb-1">🌿 Significado Clínico:</span>
                    ${tooltipDef}
                `;
                
                wrapper.appendChild(btn);
                wrapper.appendChild(tooltip);
                container.appendChild(wrapper);
            });

            // Actualizar barra de progreso
            const progress = ((currentQuestionIdx + 1) / questions.length) * 100;
            document.getElementById('progress-bar').style.width = `${progress}%`;

            // Control de navegación
            const btnPrev = document.getElementById('btn-prev');
            if (currentQuestionIdx === 0) {
                btnPrev.classList.add('opacity-40', 'cursor-not-allowed');
                btnPrev.disabled = true;
            } else {
                btnPrev.classList.remove('opacity-40', 'cursor-not-allowed');
                btnPrev.disabled = false;
            }

            // Mostrar/Ocultar retroalimentación si ya fue respondida
            const feedbackBox = document.getElementById('feedback-container');
            if (answeredQuestions[currentQuestionIdx] !== null) {
                const selectedIdx = answeredQuestions[currentQuestionIdx];
                showFeedback(selectedIdx);
            } else {
                feedbackBox.classList.add('hidden');
            }
        }

        function selectOption(optionIdx, buttonElement) {
            if (answeredQuestions[currentQuestionIdx] !== null) return;

            const q = questions[currentQuestionIdx];
            const isCorrect = q.options[optionIdx].correct;
            answeredQuestions[currentQuestionIdx] = optionIdx;

            // Bloquear todos los botones
            const buttons = document.getElementById('options-container').querySelectorAll('button');
            buttons.forEach(btn => btn.disabled = true);

            if (isCorrect) {
                buttonElement.className = "w-full text-left p-4 rounded-2xl border text-xs font-semibold bg-emerald-50 border-emerald-400 text-emerald-950 flex justify-between items-center pop-animation shadow-sm";
                buttonElement.querySelector('.indicator-icon').innerHTML = '✅';
                score += 10;
                playSynthSound('correct');
            } else {
                buttonElement.className = "w-full text-left p-4 rounded-2xl border text-xs font-semibold bg-rose-50 border-rose-300 text-rose-950 flex justify-between items-center shake-animation shadow-sm";
                buttonElement.querySelector('.indicator-icon').innerHTML = '❌';
                playSynthSound('wrong');

                // Resaltar la correcta
                buttons.forEach((btn, idx) => {
                    if (q.options[idx].correct) {
                        btn.className = "w-full text-left p-4 rounded-2xl border text-xs font-semibold bg-emerald-50 border-emerald-300 text-emerald-950 flex justify-between items-center shadow-sm";
                        btn.querySelector('.indicator-icon').innerHTML = '✅';
                    }
                });
            }

            document.getElementById('score-display').textContent = `Aciertos: ${score} / 60 Pts`;
            showFeedback(optionIdx);
        }

        function showFeedback(optionIdx) {
            const q = questions[currentQuestionIdx];
            const opt = q.options[optionIdx];
            const feedbackBox = document.getElementById('feedback-container');
            const feedbackIcon = document.getElementById('feedback-badge');
            const feedbackTitle = document.getElementById('feedback-title');
            const feedbackDesc = document.getElementById('feedback-desc');
            const leafBg = document.getElementById('feedback-bg-leaf');

            feedbackBox.classList.remove('hidden');
            if (opt.correct) {
                feedbackBox.className = "mt-6 p-5 rounded-3xl border border-emerald-200 bg-emerald-50/40 text-emerald-950 transition-all duration-300 relative overflow-hidden";
                feedbackIcon.className = "p-2.5 rounded-xl bg-emerald-100 text-emerald-800 text-base shadow-sm";
                feedbackIcon.textContent = "🛡️";
                feedbackTitle.textContent = "¡Respuesta Correcta!";
                leafBg.textContent = "🌿";
            } else {
                feedbackBox.className = "mt-6 p-5 rounded-3xl border border-rose-200 bg-rose-50/40 text-rose-950 transition-all duration-300 relative overflow-hidden";
                feedbackIcon.className = "p-2.5 rounded-xl bg-rose-100 text-rose-800 text-base shadow-sm";
                feedbackIcon.textContent = "🍁";
                feedbackTitle.textContent = "Desafiando la Trampa";
                leafBg.textContent = "🍂";
            }
            feedbackDesc.textContent = opt.feedback;
        }

        function changeQuestion(dir) {
            currentQuestionIdx += dir;
            loadQuestion();
        }

        function nextAction() {
            if (currentQuestionIdx < questions.length - 1) {
                currentQuestionIdx++;
                loadQuestion();
            } else {
                // Ir a la etapa de términos pareados
                document.getElementById('trivia-section').classList.add('hidden');
                document.getElementById('matching-section').classList.remove('hidden');
                loadMatchingGame();
            }
        }

        // ==========================================
        // ETAPA 2: JUEGO DE TÉRMINOS PAREADOS (MATCHING)
        // ==========================================
        const matchingData = [
            { id: 1, concept: "Lectura de Mente", example: '"No me saludó efusivamente, de seguro le caigo pésimo y piensa que soy una molestia."' },
            { id: 2, concept: "Catastrofismo", example: '"Si no me contesta en una hora, significa que le pasó algo terrible y chocó."' },
            { id: 3, concept: "Pensamiento Todo o Nada", example: '"Como hoy rompí mi dieta con un chocolate, ya arruiné todo, no sirvo para esto."' },
            { id: 4, concept: "Los 'Deberías'", example: '"Debo ser siempre fuerte y nunca llorar ni mostrar debilidad para que me valoren."' }
        ];

        let selectedConcept = null;
        let selectedExample = null;
        let matchedPairs = 0;

        function loadMatchingGame() {
            const conceptsGrid = document.getElementById('concepts-grid');
            const examplesGrid = document.getElementById('examples-grid');

            conceptsGrid.innerHTML = '';
            examplesGrid.innerHTML = '';

            // Mezclar elementos para el juego
            const shuffledConcepts = [...matchingData].sort(() => Math.random() - 0.5);
            const shuffledExamples = [...matchingData].sort(() => Math.random() - 0.5);

            shuffledConcepts.forEach(item => {
                const btn = document.createElement('button');
                btn.id = `concept-${item.id}`;
                btn.className = "w-full p-4 rounded-2xl border border-mauve-200 bg-mauve-50/80 text-mauve-950 text-xs font-bold transition-all text-left shadow-sm hover:bg-mauve-100/50 flex items-center justify-between group";
                btn.innerHTML = `<span>${item.concept}</span> <span class="text-mauve-300 group-hover:translate-x-1 transition-transform">&rarr;</span>`;
                btn.onclick = () => selectConceptCard(item.id, btn);
                conceptsGrid.appendChild(btn);
            });

            shuffledExamples.forEach(item => {
                const btn = document.createElement('button');
                btn.id = `example-${item.id}`;
                // Letra en formato regular, muy clara y legible (sin cursivas inclinadas que cansen la vista)
                btn.className = "w-full p-4 rounded-2xl border border-sage-200 bg-sage-50/70 text-stone-800 text-xs font-medium transition-all text-left shadow-sm hover:bg-sage-100/50 flex items-center justify-between group";
                btn.innerHTML = `<span>${item.example}</span> <span class="text-sage-300 group-hover:-translate-x-1 transition-transform">&larr;</span>`;
                btn.onclick = () => selectExampleCard(item.id, btn);
                examplesGrid.appendChild(btn);
            });
        }

        function selectConceptCard(id, element) {
            if (element.classList.contains('bg-emerald-50')) return;

            // Remover bordes activos previos
            document.querySelectorAll('[id^="concept-"]').forEach(btn => {
                if (!btn.classList.contains('bg-emerald-50')) {
                    btn.className = "w-full p-4 rounded-2xl border border-mauve-200 bg-mauve-50/80 text-mauve-950 text-xs font-bold transition-all text-left shadow-sm hover:bg-mauve-100/50 flex items-center justify-between group";
                    btn.innerHTML = `<span>${btn.querySelector('span').textContent}</span> <span class="text-mauve-300 group-hover:translate-x-1 transition-transform">&rarr;</span>`;
                }
            });

            selectedConcept = { id, element };
            element.className = "w-full p-4 rounded-2xl border-2 border-mauve-600 bg-mauve-100 text-mauve-950 text-xs font-extrabold transition-all text-left shadow-md scale-[1.01] flex items-center justify-between";
            element.innerHTML = `<span>${element.querySelector('span').textContent}</span> <span class="text-mauve-600 font-bold">💜</span>`;

            checkMatch();
        }

        function selectExampleCard(id, element) {
            if (element.classList.contains('bg-emerald-50')) return;

            // Remover bordes activos previos
            document.querySelectorAll('[id^="example-"]').forEach(btn => {
                if (!btn.classList.contains('bg-emerald-50')) {
                    btn.className = "w-full p-4 rounded-2xl border border-sage-200 bg-sage-50/70 text-stone-800 text-xs font-medium transition-all text-left shadow-sm hover:bg-sage-100/50 flex items-center justify-between group";
                    btn.innerHTML = `<span>${btn.querySelector('span').textContent}</span> <span class="text-sage-300 group-hover:-translate-x-1 transition-transform">&larr;</span>`;
                }
            });

            selectedExample = { id, element };
            element.className = "w-full p-4 rounded-2xl border-2 border-sage-500 bg-sage-100 text-stone-900 text-xs font-extrabold transition-all text-left shadow-md scale-[1.01] flex items-center justify-between";
            element.innerHTML = `<span>${element.querySelector('span').textContent}</span> <span class="text-sage-600 font-bold">🌿</span>`;

            checkMatch();
        }

        function checkMatch() {
            if (selectedConcept && selectedExample) {
                if (selectedConcept.id === selectedExample.id) {
                    playSynthSound('match');
                    
                    selectedConcept.element.className = "w-full p-4 rounded-2xl border border-emerald-400 bg-emerald-50 text-emerald-950 text-xs font-bold transition-all text-left flex justify-between items-center pop-animation shadow-sm";
                    selectedConcept.element.innerHTML = `<span>${selectedConcept.element.querySelector('span').textContent}</span> <span class="text-emerald-600">🌿 Acierto</span>`;
                    
                    selectedExample.element.className = "w-full p-4 rounded-2xl border border-emerald-400 bg-emerald-50 text-emerald-900 text-xs font-medium transition-all text-left flex justify-between items-center pop-animation shadow-sm";
                    selectedExample.element.innerHTML = `<span>${selectedExample.element.querySelector('span').textContent}</span> <span class="text-emerald-600">🌿 Acierto</span>`;

                    selectedConcept = null;
                    selectedExample = null;
                    matchedPairs++;

                    if (matchedPairs === matchingData.length) {
                        setTimeout(() => {
                            playSynthSound('correct');
                            // Mostrar Modal de éxito interactivo (Reemplaza al alert convencional)
                            showSuccessModal();
                        }, 500);
                    }
                } else {
                    playSynthSound('wrong');
                    selectedConcept.element.classList.add('shake-animation');
                    selectedExample.element.classList.add('shake-animation');

                    const tempConcept = selectedConcept;
                    const tempExample = selectedExample;

                    setTimeout(() => {
                        tempConcept.element.classList.remove('shake-animation');
                        tempExample.element.classList.remove('shake-animation');
                        
                        tempConcept.element.className = "w-full p-4 rounded-2xl border border-mauve-200 bg-mauve-50/80 text-mauve-950 text-xs font-bold transition-all text-left shadow-sm hover:bg-mauve-100/50 flex items-center justify-between group";
                        tempConcept.element.innerHTML = `<span>${tempConcept.element.querySelector('span').textContent}</span> <span class="text-mauve-300 group-hover:translate-x-1 transition-transform">&rarr;</span>`;
                        
                        tempExample.element.className = "w-full p-4 rounded-2xl border border-sage-200 bg-sage-50/70 text-stone-800 text-xs font-medium transition-all text-left shadow-sm hover:bg-sage-100/50 flex items-center justify-between group";
                        tempExample.element.innerHTML = `<span>${tempExample.element.querySelector('span').textContent}</span> <span class="text-sage-300 group-hover:-translate-x-1 transition-transform">&larr;</span>`;
                    }, 400);

                    selectedConcept = null;
                    selectedExample = null;
                }
            }
        }

        // FUNCIONES DEL MODAL DE ÉXITO PERSONALIZADO
        function showSuccessModal() {
            document.getElementById('successModal').classList.remove('hidden');
        }

        function closeSuccessModal() {
            document.getElementById('successModal').classList.add('hidden');
            restartAll();
        }

        function restartAll() {
            currentQuestionIdx = 0;
            score = 0;
            matchedPairs = 0;
            answeredQuestions = Array(questions.length).fill(null);
            document.getElementById('score-display').textContent = `Aciertos: 0 / 60 Pts`;
            
            document.getElementById('matching-section').classList.add('hidden');
            document.getElementById('trivia-section').classList.remove('hidden');
            
            loadQuestion();
        }

        window.onload = function() {
            loadQuestion();
        }
    </script>
</body>
</html>
