        }
        .serif-title {
            font-family: 'Playfair Display', serif;
        }
        
        /* Animaciones Orgánicas de Plantas con el Viento */
        @keyframes sway {
            0%, 100% { transform: rotate(0deg) skewX(0deg); }
            50% { transform: rotate(2deg) skewX(1deg); }
        }
        .animate-sway {
            animation: sway 7s ease-in-out infinite;
            transform-origin: top left;
        }

        @keyframes sway-slow {
            0%, 100% { transform: rotate(0deg) skewX(0deg); }
            50% { transform: rotate(-1.5deg) skewX(-1deg); }
        }
        .animate-sway-slow {
            animation: sway-slow 9s ease-in-out infinite;
            transform-origin: top right;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
        }
        .shake-animation {
            animation: shake 0.3s ease-in-out;
        }
        
        @keyframes pop {
            0% { transform: scale(1); }
            50% { transform: scale(1.03); }
            100% { transform: scale(1); }
        }
        .pop-animation {
            animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        /* Efecto de Diario/Papel de consulta */
        .journal-border {
            position: relative;
            border: 1px solid #e1d3e3;
